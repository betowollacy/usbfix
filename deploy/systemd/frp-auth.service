[Unit]
Description=USB FIX FRP authorization plugin
After=network.target

[Service]
Type=simple
User=tunnel
Group=tunnel
WorkingDirectory=/opt/tunnel/server
EnvironmentFile=/etc/tunnel/env
ExecStart=/opt/tunnel/venv/bin/uvicorn frp_plugin:app --host 127.0.0.1 --port 9000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tunnel/data

[Install]
WantedBy=multi-user.target
